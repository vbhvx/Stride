# Stride - Employee Growth & Career Progression Platform
# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/stride_dev"
TEST_DATABASE_URL="postgresql://username:password@localhost:5432/stride_test"

# Application Settings
NEXT_PUBLIC_APP_NAME="Stride"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Provider Configuration (mock | gemini | openai)
# Set to 'mock' for local development & automated testing without external API calls
AI_PROVIDER="mock"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Security & Session
SESSION_SECRET="stride-platform-dev-secret-key-32chars-minimum-safe"

